+/// Counters of the rebuild's work, for jegg's probe of its rebuild against egg's
+/// (vecbricks/jegg#134, dev/fuzz/probe.patch). Not egg's code: applied to the cached checkout
+/// by dev/egg_harness.sh. The names index the counts.
+pub mod probe {
+    use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+    pub const NAMES: [&str; 12] = [
+        "pops", "pended_added", "pended_absorbed", "memo_collisions", "congruence_unions",
+        "union_kept_parents", "unions", "analysis_pops", "modify_calls", "rebuild_classes",
+        "rebuild_nodes", "rebuild_trimmed",
+    ];
+    pub static COUNTS: [AtomicUsize; 12] = [const { AtomicUsize::new(0) }; 12];
+
+    pub fn bump(i: usize, n: usize) {
+        COUNTS[i].fetch_add(n, Relaxed);
+    }
+
+    pub fn reset() {
+        for c in COUNTS.iter() {
+            c.store(0, Relaxed);
+        }
+    }
+
+    pub fn snapshot() -> [usize; 12] {
+        core::array::from_fn(|i| COUNTS[i].load(Relaxed))
+    }
+}
+

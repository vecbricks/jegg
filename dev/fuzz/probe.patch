@@ -51,6 +51,46 @@ pub(crate) mod no_std_prelude {
     };
 }
 
+/// Counters of the rebuild's work, for jegg's probe of its rebuild against egg's
+/// (vecbricks/jegg#134, dev/fuzz/probe.patch). Not egg's code: applied to the cached checkout
+/// by dev/egg_harness.sh. The names index the counts.
+pub mod probe {
+    use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+    pub const NAMES: [&str; 24] = [
+        "pops", "pended_added", "pended_absorbed", "memo_collisions", "congruence_unions",
+        "union_kept_parents", "unions", "analysis_pops", "modify_calls", "rebuild_classes",
+        "rebuild_nodes", "rebuild_trimmed", "adds", "add_hits", "add_news", "modify_from_add",
+        "union_calls", "union_effective", "matches_applied", "apply_adds", "apply_news",
+        "applications", "apply_news_merged", "apply_news_merged_leaf",
+    ];
+    /// The classes the right-hand sides made since the last rebuild (#137).
+    static NEWS: std::sync::Mutex<Vec<u32>> = std::sync::Mutex::new(Vec::new());
+
+    pub fn push_new(id: usize) {
+        NEWS.lock().unwrap().push(id as u32);
+    }
+
+    pub fn take_news() -> Vec<u32> {
+        core::mem::take(&mut *NEWS.lock().unwrap())
+    }
+    pub static COUNTS: [AtomicUsize; 24] = [const { AtomicUsize::new(0) }; 24];
+
+    pub fn bump(i: usize, n: usize) {
+        COUNTS[i].fetch_add(n, Relaxed);
+    }
+
+    pub fn reset() {
+        for c in COUNTS.iter() {
+            c.store(0, Relaxed);
+        }
+    }
+
+    pub fn snapshot() -> [usize; 24] {
+        core::array::from_fn(|i| COUNTS[i].load(Relaxed))
+    }
+}
+

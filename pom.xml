<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.vecbricks</groupId>
  <artifactId>jegg</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>jegg</name>
  <description>E-graphs and equality saturation for Java 25, a port of egg</description>
  <url>https://github.com/vecbricks/jegg</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>MaxGekk</id>
      <name>Max Gekk</name>
      <organization>vecbricks</organization>
      <organizationUrl>https://github.com/vecbricks</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/vecbricks/jegg.git</connection>
    <developerConnection>scm:git:git@github.com:vecbricks/jegg.git</developerConnection>
    <url>https://github.com/vecbricks/jegg</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- Java 25 is the floor: records, sealed hierarchies and exhaustive switch carry the
         design (PLAN.md 2 and 3.1); no incubator module is needed, unlike Varka's engine. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <jmh.version>1.37</jmh.version>
    <maven.surefire.version>3.2.5</maven.surefire.version>
    <!-- JUnit tags to skip, e.g. -Dsurefire.excludedGroups=slow; CI skips none. -->
    <surefire.excludedGroups></surefire.excludedGroups>
    <!-- The coverage gate over src/main: the lowest line and branch ratios `verify` accepts.
         A little under the measured numbers (97.7% and 93.4%), so one uncovered branch in a
         small class does not fail a change, and an untested feature does. A change that moves
         them says so in its description (CONTRIBUTING.md). -->
    <coverage.minimum.line>0.97</coverage.minimum.line>
    <coverage.minimum.branch>0.92</coverage.minimum.branch>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The measurement harness of PLAN.md 6, under src/jmh/java: compiled with the tests on
         every build, run under the bench profile (see benchmarks/README.md). -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <!-- The tests compile with JMH's annotation processor, which since JDK 23 runs only
               when asked (-proc:full); the processing lint is off there, as the processor
               claims no JUnit annotation. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-processing</arg>
                <arg>-Werror</arg>
                <arg>-proc:full</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.version}</version>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-benchmark-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/jmh/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Line and branch coverage of src/main by the tests, written to target/site/jacoco on
           every verify, and summed up in the console by CoverageSummary right after. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum.line}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum.branch}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>coverage-summary</id>
            <phase>verify</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>io.github.vecbricks.jegg.CoverageSummary</mainClass>
              <arguments>
                <argument>${project.build.directory}/site/jacoco/jacoco.csv</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The Javadoc of the public surface, checked on every verify under doclint with every
           warning an error, so a broken {@link} fails the change and not the Pages deploy
           (javadoc.yml runs the same configuration). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <!-- Everything but "missing": the 296 absent @param, @return and comments on main are a
               follow-up (#57); syntax, HTML, references and accessibility fail now. -->
          <doclint>all,-missing</doclint>
          <failOnWarnings>true</failOnWarnings>
          <failOnError>true</failOnError>
          <!-- javadoc stops reporting at 100 warnings; a fix should see them all. -->
          <additionalOptions>
            <additionalOption>-Xmaxwarns</additionalOption>
            <additionalOption>10000</additionalOption>
          </additionalOptions>
        </configuration>
        <executions>
          <execution>
            <id>javadoc-check</id>
            <phase>verify</phase>
            <goals>
              <goal>javadoc</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.vecbricks.jegg</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The measurement: mvn -Pbench -q test-compile exec:exec -Dbench=<name>, which runs the
         JMH harness in a JVM with the test classpath (JMH forks read java.class.path, which
         exec:java would not set) and writes benchmarks/<Name>-jdk25-results.txt. -->
    <profile>
      <id>bench</id>
      <properties>
        <bench>all</bench>
        <bench.quick>false</bench.quick>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <executable>java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>-Dbench=${bench}</argument>
                <argument>-Dbench.quick=${bench.quick}</argument>
                <argument>io.github.vecbricks.jegg.Benchmarks</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Publishing, configured from the first commit (PLAN.md 7, risk 7): sources and javadoc
         jars, signatures, and the Central portal. Releases are cut from tags; Varka pins a
         released version and never a snapshot. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.10.1</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
